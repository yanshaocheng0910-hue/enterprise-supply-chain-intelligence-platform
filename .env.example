# scic-platform local/Compose environment template.
# Copy to D:\论文\.env and replace every value marked CHANGE_ME.
# The school Word/Excel templates are not filled by this file; this is only a
# runtime configuration example for the UAT candidate.

SCIC_SERVER_PORT=8080
SCIC_DB_DRIVER=org.h2.Driver
SCIC_DB_URL=jdbc:h2:file:D:/论文/.data/h2/scic;MODE=MySQL;DATABASE_TO_LOWER=TRUE;AUTO_SERVER=TRUE
SCIC_DB_USER=sa
SCIC_DB_PASSWORD=
SCIC_JWT_SECRET=CHANGE_ME_use_a_long_random_secret_for_local_or_deployment
SCIC_JWT_EXPIRATION_SECONDS=28800
SCIC_AI_BASE_URL=http://127.0.0.1:8001
SCIC_AI_SERVICE_TOKEN=CHANGE_ME_local_ai_service_token
X_SERVICE_TOKEN=CHANGE_ME_local_ai_service_token
SCIC_AI_CONNECT_TIMEOUT_MS=2000
SCIC_AI_READ_TIMEOUT_MS=15000
SCIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCIC_LOG_FILE=D:/论文/.data/logs/backend.log

# FastAPI AI service
LLM_PROVIDER=rule
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=15
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVICE_NAME=ai-service
SERVICE_VERSION=0.1.0

# Frontend and project-local dependency caches.  Do not redirect these to C:.
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_DEMO_FALLBACK=false
PIP_CACHE_DIR=D:/论文/.cache/pip
npm_config_cache=D:/论文/.cache/npm
MAVEN_USER_HOME=D:/论文/.cache/m2
MAVEN_ARGS=-Dmaven.repo.local=D:/论文/.cache/m2

# Compose-only values.  Bind mounts remain under D:\论文\.data.
MYSQL_DATABASE=scic_platform
MYSQL_USER=scic
MYSQL_PASSWORD=CHANGE_ME_mysql_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
SCIC_DATA_DIR=D:/论文/.data
COMPOSE_PROJECT_NAME=scic-platform
