# Internal caller token.  Replace this value outside local development.
X_SERVICE_TOKEN=replace-with-a-long-random-token

# rule is deterministic and the default.  Use openai-compatible only when all
# three provider settings below are supplied; failed calls fall back to rule.
LLM_PROVIDER=rule
OPENAI_BASE_URL=
LLM_LOCAL_ONLY=true
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_TOKENS=512

# Never use '*' here: the CORS allow-list is intentionally narrow.
CORS_ALLOW_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SERVICE_NAME=ai-service
SERVICE_VERSION=0.1.0
